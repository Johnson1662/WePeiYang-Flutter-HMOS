{
  "module": {
    "name": "sdcform",
    "type": "shared",
    "formExtensionModule": "entry",
    "description": "课程表桌面卡片",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:form_pages",
    "extensionAbilities": [
      {
        "name": "SDCFormAbility",
        "srcEntry": "./ets/widget/SDCFormAbility.ets",
        "label": "课表",
        "description": "课程表桌面卡片",
        "type": "form",
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_widget_config"
          }
        ]
      }
    ]
  }
}
